# Database & Cache (Default Docker Compose settings)
DATABASE_URL="postgres://rzp:rzp@localhost:5433/rzp_merchant"
REDIS_URL="redis://localhost:6379"

# Better Auth Authentication Settings
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-key-32-chars-min"
BETTER_AUTH_URL="http://localhost:3000"

# Email Verification & Password Reset (Resend.com API Key)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# LLM API Key (Required for AI agent search, recommendations & chat; fallback: OPENAI_API_KEY)
LLM_API_KEY=""

# Optional LLM / Embedding Overrides
# LLM_MODEL="gpt-4o-mini"
# LLM_BASE_URL="https://api.openai.com/v1"
#
# If using a separate provider for embeddings (e.g. OpenAI embeddings while using Groq/Ollama for chat):
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_BASE_URL="https://api.openai.com/v1"
# EMBEDDING_API_KEY=""

# Razorpay API Credentials (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Razorpay Webhook Secret (Optional on localhost; used to verify webhook signatures)
RAZORPAY_WEBHOOK_SECRET=""

# Merchant Dashboard Auth (/dashboard, /products, /orders)
MERCHANT_PASSWORD="admin"
MERCHANT_SESSION_SECRET="change-this-to-a-secure-random-secret-key-32-chars-min"
